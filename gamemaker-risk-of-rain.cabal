cabal-version:  3.0

name:           gamemaker-risk-of-rain
version:        0.4.0.0
synopsis:       Risk of Rain 1 GameMaker data file unpacking
description:
  Please see the README on GitHub at <https://github.com/burningwitness/gamemaker-risk-of-rain#readme>

category:       Decompiler
author:         Oleksii Divak
maintainer:     Oleksii Divak <frozenwitness@gmail.com>
copyright:      (c) 2021, Oleksii Divak
license:        BSD-3-Clause
license-file:   LICENSE
build-type:     Simple

extra-doc-files:
  README.md


source-repository head
  type: git
  location: https://github.com/burningwitness/gamemaker-risk-of-rain.git


library
  exposed-modules:  GameMaker.RiskOfRain.Decoder

  hs-source-dirs:   src

  ghc-options:      -Wall

  build-depends:    base       >= 4.12   && < 5
                  , bytestring >= 0.10.4 && < 0.13
                  , lathe      >= 0.1    && < 0.2
                  , primitive  >= 0.7    && < 0.10
                  , radix-tree >= 1.1    && < 1.2

  default-language: Haskell2010


executable examine
  main-is:          Main.hs

  hs-source-dirs:   examine

  ghc-options:      -Wall

  build-depends:    base
                  , bytestring
                  , gamemaker-risk-of-rain
                  , lathe
                  , primitive
                  , radix-tree
                  , time                   >= 1.11 && < 1.15

  default-language: Haskell2010


executable decompile
  main-is:          Main.hs

  hs-source-dirs:   decompile

  other-modules:    Decompile
                    Disassemble
                    Display

  ghc-options:      -Wall

  build-depends:    base
                  , bytestring
                  , gamemaker-risk-of-rain
                  , lathe
                  , primitive
                  , radix-tree

  default-language: Haskell2010
